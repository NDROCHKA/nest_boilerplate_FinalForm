# Application
NODE_ENV=development
APP_NAME=Crusaders Web
APP_PORT=3000
API_PREFIX=api
FRONTEND_DOMAIN=http://localhost:5173
BACKEND_DOMAIN=http://localhost:3000
TRUST_PROXY_HOPS=0
UPLOADS_DIR=uploads
SHOW_ERROR_DETAILS=false

# Authentication - generate two different high-entropy values for production
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_JWT_ISSUER=crusaders-api
AUTH_JWT_AUDIENCE=crusaders-web

# PostgreSQL (DATABASE_URL may replace the individual connection fields)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=crusaders
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=true

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=change-me
MAIL_PASSWORD=change-me
MAIL_DEFAULT_NAME=Crusaders
MAIL_DEFAULT_EMAIL=no-reply@example.com

# One-time super-administrator bootstrap (remove these after seeding)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
SEED_SUPER_ADMIN_PHONE=
