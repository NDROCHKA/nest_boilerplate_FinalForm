{
  "name": "1-getting-started-with-nest-js",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "cross-env NODE_OPTIONS=\"--no-warnings=DEP0190\" nest start --watch",
    "debug": "cross-env NODE_OPTIONS=\"--no-warnings=DEP0190\" nest start --debug --watch",
    "prod": "node dist/main.js",
    "start:prod": "npm run prod",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "lint:all": "npm run lint && npm --prefix frontend run lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "env-cmd -- ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:generate src/database/migrations/init",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js --dataSource=dist/database/data-source.js migration:run",
    "migration:revert": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:revert",
    "schema:drop": "npm run typeorm -- --dataSource=src/database/data-source.ts schema:drop",
    "seed:run:total": "ts-node -r tsconfig-paths/register ./src/database/seeds/relational/total-seed.ts",
    "seed:run:partial": "ts-node -r tsconfig-paths/register ./src/database/seeds/relational/partial-seed.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register ./src/database/seeds/relational/admin-seed.ts",
    "refresh:partial": "yarn schema:drop && rimraf \"src/database/migrations\" && node -e \"require('fs').mkdirSync('src/database/migrations')\" && yarn migration:generate && yarn migration:run && yarn seed:run:partial",
    "npm:refresh:partial": "npm run schema:drop && rimraf \"src/database/migrations\" && node -e \"require('fs').mkdirSync('src/database/migrations')\" && npm run migration:generate && npm run migration:run && npm run seed:run:partial",
    "npm:refresh:total": "npm run schema:drop && rimraf \"src/database/migrations\" && node -e \"require('fs').mkdirSync('src/database/migrations')\" && npm run migration:generate && npm run migration:run && npm run seed:run:total",
    "refresh:total": "yarn schema:drop && rimraf \"src/database/migrations\" && node -e \"require('fs').mkdirSync('src/database/migrations')\" && yarn migration:generate && yarn migration:run && yarn seed:run:total",
    "prebuild": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!**/*.module.ts",
      "!src/main.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    }
  }
}
